{
  "name": "cockpit",
  "version": "0.3.0-preview.2",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "scripts"
  ],
  "bin": {
    "cockpit": "./scripts/cockpit.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:core": "tsc --noEmit && vite build && tsc src/parser.ts --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck --outDir dist",
    "build": "npm run build:core && node scripts/freshness.mjs --stamp",
    "prepack": "npm run build",
    "preview": "vite preview",
    "cockpit": "node scripts/cockpit.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "mermaid": "^11.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
